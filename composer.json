{
  "name": "local/doors-accounting",
  "description": "Система учёта дверей, выполненных работ и оплаты труда",
  "type": "project",
  "require": {
    "php": ">=8.0",
    "ext-pdo": "*",
    "ext-bcmath": "*",
    "ext-gd": "*",
    "ext-fileinfo": "*",
    "mpdf/mpdf": "^8.2",
    "phpoffice/phpspreadsheet": "^1.29",
    "ext-mbstring": "*",
    "ext-zip": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true
  }
}
