# Application
APP_ENV=production
APP_DEBUG=0
APP_TIMEZONE=Europe/Kaliningrad
APP_ORG_NAME=Организация
APP_CURRENCY=₽
SESSION_SECURE=1
SESSION_IDLE_MINUTES=720

# MariaDB
DB_HOST=doors-db
DB_PORT=3306
