DB_USER=doors
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Docker Compose
HTTP_PORT=8066
DATA_DIR=./data
PHP_IMAGE=php:8.0-apache
